Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Axes
      Name: The radar (radar_link)
      Enabled: true
      Length: 0.5
      Radius: 0.03
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Radar points
      Enabled: true
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Topic:
        Value: /radar/points
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: Radar clusters
      Enabled: true
      Size (m): 0.08
      Style: Flat Squares
      Color Transformer: RGB8
      Topic:
        Value: /radar/clusters
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/MarkerArray
      Name: Radar boxes
      Enabled: true
      Topic:
        Value: /radar/cluster_boxes
  Global Options:
    Fixed Frame: radar_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 60
      Target Frame: <Fixed Frame>
      X: 4
      Y: 0
