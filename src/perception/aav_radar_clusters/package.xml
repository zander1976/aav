<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_radar_clusters</name>
  <version>0.1.0</version>
  <description>radar_clusters in Rust (rclrs): DBSCAN groups the radar's points (/radar/points) into objects, on /radar/clusters, with a box round each on /radar/cluster_boxes for RViz. Rewritten from the 2025-26 C++ node (aav_object_detection's dbscan).</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclrs links rcl; ros-env compiles the Rust message code these packages ship. -->
  <depend>rcl</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- radar_clusters.launch.py: mock:=true starts its pretend radar; radar_rviz:=true, RViz. -->
  <exec_depend>ti_ros2_driver</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
