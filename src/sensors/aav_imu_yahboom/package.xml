<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aav_imu_yahboom</name>
  <version>0.1.0</version>
  <description>imu_node in Rust (rclrs): the Yahboom 10-axis IMU on /imu/data_raw and /imu/mag. Rewritten from the 2025-26 C++ driver (yahboom_imu_cpp, now removed), with its node name, parameters, topics and units.</description>
  <maintainer email="aav-team@todo.invalid">AAV 2026-27 team</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- rclrs links rcl; ros-env compiles the Rust message code these packages ship. -->
  <depend>rcl</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
